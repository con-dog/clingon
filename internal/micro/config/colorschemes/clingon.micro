# clingon's palette (see internal/ui/styles.go) on the terminal's own
# background: pink accents, periwinkle keys (the strong purple is the prompt's),
# lavender chrome.
color-link default "default,default"
color-link comment "103"
color-link todo "bold 215"
color-link type "147"
color-link identifier "147"
color-link statement "103"
color-link symbol "103"
color-link preproc "147"
color-link special "212"
color-link underlined "underline 212"
color-link constant "212"
color-link constant.string "180"
color-link constant.number "212"
color-link constant.bool "212"
color-link error "204"
color-link line-number "60"
color-link current-line-number "212"
color-link gutter-warning "215"
color-link indent-char "60"
color-link match-brace "bold 212"
color-link selection "reverse"
color-link hlsearch "reverse"
color-link statusline "bold 212"
color-link tabbar "103"
color-link divider "60"
color-link scrollbar "60"
color-link message "103"
color-link diff-added "79"
color-link diff-modified "215"
color-link diff-deleted "204"
color-link cursor-line "default"
color-link color-column "default"
# Packs (syntax/markdown.yaml): the menu's colours for what each line is.
color-link special.heading "bold 212"
color-link special.hash "60"
color-link special.blank "117"
color-link special.mark "147"
color-link special.warning "bold 215"
color-link special.caution "bold 204"
color-link special.program "79"
color-link special.value "default"
color-link special.fence "103"
# Packs' checks (plug/clingon): issues as an orange chip, like clingon's status
# bar, marked in the gutter in the same orange. The gutter's own unseen mark
# keeps its room (233: the window's ink).
color-link error-message "bold 233,215"
color-link gutter-error "bold 215"
color-link gutter-info "233"
